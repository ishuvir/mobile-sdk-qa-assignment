{
  "request": {
    "method": "POST",
    "url": "/auth/token",
    "bodyPatterns": [
      {
        "contains": "refresh_token=RT-old"
      }
    ]
  },
  "response": {
    "status": 200,
    "fixedDelayMilliseconds": 300,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "access_token": "AT-new",
      "refresh_token": "RT-new",
      "expires_in": 900
    }
  }
}
